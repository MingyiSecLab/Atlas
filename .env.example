# Keep the desktop app on the deterministic local runtime by default.
MINGYI_RUNTIME=fake

# Set MINGYI_RUNTIME=pi to use the Pi agent runtime.
# MINGYI_PROVIDER_ID=openai
# MINGYI_PROVIDER_NAME=OpenAI
# MINGYI_API_STYLE=openai-responses
# MINGYI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MINGYI_AUTH_KIND=api-key
# MINGYI_BASE_URL=
# MINGYI_MODEL_ID=
# MINGYI_MODEL_REASONING=false
# MINGYI_MODEL_IMAGES=true
# MINGYI_WORKSPACE_ROOT=/absolute/path/to/workspace
# MINGYI_CONTEXT_WINDOW=128000
# MINGYI_MAX_TOKENS=8192
